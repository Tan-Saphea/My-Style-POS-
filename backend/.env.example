# Application Environment & Server
NODE_ENV=development
PORT=5001

# Database Configuration (MongoDB Connection String)
# Transactions require a replica set. The root docker-compose.yml exposes one on 27029.
# Example local: mongodb://127.0.0.1:27029/clothing_sales_db?replicaSet=rs0
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/clothing_sales_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27029/clothing_sales_db?replicaSet=rs0

# CORS Allowed Origins (Comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000

# JSON Web Tokens (JWT) Secrets & Lifespans
# Generate strong 256-bit secrets using: openssl rand -base64 32
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long_12345
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing Security
BCRYPT_SALT_ROUNDS=12

# Cookie Security (Signed Cookies)
COOKIE_SECRET=your_super_secret_cookie_signing_key_min_32_characters_99999

# Rate Limiting Configuration
# Window in milliseconds (900000ms = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# General API Max Requests per Window per IP
RATE_LIMIT_MAX=100
# Auth/Sensitive Endpoint Max Requests per Window per IP
RATE_LIMIT_AUTH_MAX=10
